META_API_KEY=
ERP_URL=http://127.0.0.1:8090
ERP_PORT=8090
ERP_SITE=floorvoice.local
ERP_ADMIN_PASSWORD=
# written by seed/seed.py
ERP_API_KEY=
ERP_API_SECRET=
# shared access key for the PWA (append ?k=<key> to the URL once)
FLOORVOICE_KEY=
# salt for worker PIN hashes on Employee (seed/seed.py generates one if empty)
FLOORVOICE_PIN_SALT=
# public ERPNext desk URL for "Open in ERPNext" links (scripts/erp_tunnel.sh sets it for you)
ERP_PUBLIC_URL=
# stock count by filming the shelf (SAM 3.1)
FEATURE_VIDEO_COUNT=true
# your frappe_docker bench: image, sites volume, network, backend container
ERP_BENCH_IMAGE=frappe/erpnext:v15
ERP_SITES_VOLUME=frappe_docker_sites
ERP_BENCH_NETWORK=frappe_docker_default
ERP_BENCH_CONTAINER=frappe_docker-backend-1
# optional: what the demo shelf really holds, e.g. BRG-6305=mug (kept across demo_reset)
DEMO_COUNT_PROMPTS=
